# Copy to .env. Required for docker compose: POSTGRES_PASSWORD and JWT_SECRET.
POSTGRES_PASSWORD=change-me
JWT_SECRET=                    # openssl rand -base64 48
ADMIN_EMAIL=admin@example.com  # created/promoted to admin on start
ADMIN_PASSWORD=                # 12+ characters
CORS_ORIGIN=http://localhost:4000
COOKIE_SECURE=false            # true when served over HTTPS
SEED_DEMO=false                # demo records are disabled by default; opt in only for local tests
OFFICIAL_SCHEME_FEEDS=[]       # JSON array of {key,name,url,token?}; HTTPS gov.in/nic.in normalized JSON feeds
OFFICIAL_SCHEME_SYNC_MINUTES=60

# Local development without Postgres: leave DATABASE_URL unset and the API uses embedded Postgres (PGlite).
# DATABASE_URL=postgres://user:pass@host:5432/schemepulse
# PGLITE_DIR=./.data/pglite

# AI (optional). Default "rules" is fully deterministic and needs no key.
AI_PROVIDER=rules              # rules | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (optional). Without SMTP_URL, reminder emails are only logged.
SMTP_URL=                      # smtp://user:pass@smtp.example.com:587
MAIL_FROM=SchemePulse <no-reply@example.com>

# Document storage. local = disk (mount a volume). s3 = any S3-compatible bucket (npm i @aws-sdk/client-s3 in server/)
STORAGE_DRIVER=local
UPLOAD_DIR=./.data/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
